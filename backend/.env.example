PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Isi dengan connection string Postgres kamu (Supabase / Railway Postgres / lokal).
# Contoh format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/cerdas_cermat

# Kunci rahasia untuk menandatangani token login guru. Ganti dengan string
# acak yang panjang saat deploy — jangan pernah pakai nilai contoh ini.
# Bisa generate cepat lewat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
